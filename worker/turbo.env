# YuE2-Turbo settings for a single 24 GB GPU (L4 / A10G).
# Upstream defaults are tuned for a 32 GB RTX 5090.
YUE2_HOST=127.0.0.1
YUE2_PORT=8000
YUE2_DATA_DIR=/opt/yue/data
HF_HOME=/opt/yue/hf
CUDA_VISIBLE_DEVICES=0
YUE2_BACKEND=vllm
YUE2_RESIDENT_MODELS=true
YUE2_AR_CONCURRENCY=2
YUE2_VLLM_MAX_NUM_SEQS=2
YUE2_NAR_BATCH_SIZE=1
YUE2_VLLM_GPU_MEMORY_UTILIZATION=0.34
YUE2_MEMORY_BUDGET_GIB=20
YUE2_MAX_PENDING=8
YUE2_TASK_TIMEOUT_SECONDS=2400
YUE2_SHEETSAGE_DEVICE=auto
YUE2_SHEETSAGE_MIN_FREE_GIB=5
YUE2_ARTIFACT_RETENTION_SECONDS=7200
YUE2_ARTIFACT_MAX_GIB=3
YUE2_WARMUP=true
